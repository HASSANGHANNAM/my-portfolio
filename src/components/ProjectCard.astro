---
import type { Project } from "../types/portfolio";

interface Props {
	project: Project;
	index: number;
}

const { project, index } = Astro.props;
const formatDate = (date: string) =>
	new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(
		new Date(date),
	);
---

<article
	class="group relative flex h-full cursor-pointer flex-col rounded-2xl border border-slate-200 bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-emerald-400 hover:shadow-[0_14px_40px_rgba(16,185,129,0.12)] dark:border-slate-700/80 dark:bg-slate-800"
	data-project-open={project.id}
>
	<div class="mb-6 flex items-start justify-between gap-4">
		<span class="font-mono text-sm font-semibold text-emerald-400">
			{index + 1 < 10 ? `0${index + 1}` : index + 1}
		</span>
		<span
			class="rounded-full border border-slate-300 px-3 py-1 text-xs text-slate-600 dark:border-slate-600 dark:text-slate-300"
		>
			{project.projectType}
		</span>
	</div>

	<h3
		class="text-xl font-semibold text-slate-950 transition-colors group-hover:text-emerald-400 dark:text-slate-100"
	>
		{project.title}
	</h3>

	<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
		{formatDate(project.startDate)} - {formatDate(project.endDate)}
	</p>

	{
		project.problem && (
			<p class="mt-4 text-sm leading-6 text-slate-600 dark:text-slate-300 line-clamp-3">
				{project.problem}
			</p>
		)
	}

	{
		project.keyHighlights && project.keyHighlights.length > 0 && (
			<ul class="mt-5 space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
				{project.keyHighlights.map((highlight) => (
					<li class="flex gap-2">
						<span class="text-emerald-400">+</span>
						{highlight}
					</li>
				))}
			</ul>
		)
	}

	<div class="mt-auto flex flex-wrap gap-2 pt-7">
		{
			project.techStack.map((technology) => (
				<span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs text-slate-700 dark:bg-slate-700/80 dark:text-slate-200">
					{technology}
				</span>
			))
		}
	</div>

	{/* قسم الرابط والسهم في الأسفل */}
	<div
		class="mt-7 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-700/50"
	>
		<span
			class="text-sm font-semibold text-emerald-400 transition-colors group-hover:text-emerald-300"
		>
			View Details
		</span>
		<span
			class="flex h-8 w-8 items-center justify-center rounded-full border border-emerald-400/60 text-sm text-emerald-400 transition-transform duration-200 group-hover:translate-x-1 group-hover:bg-emerald-400 group-hover:text-slate-950"
		>
			→
		</span>
	</div>
</article>
