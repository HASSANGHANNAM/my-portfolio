---
import skills from '../data/en/skills.json';
---

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
	{(['Practical Skills', 'Theoretical Knowledge'] as const).map((layer) => <section class="contents" aria-labelledby={layer.toLowerCase().replaceAll(' ', '-')}>
		<div class="col-span-full mt-6 first:mt-0"><h2 id={layer.toLowerCase().replaceAll(' ', '-')} class="mt-2 text-2xl font-semibold text-slate-950 dark:text-white">{layer}</h2></div>
		{skills.filter((category) => category.layer === layer).map((category) => (
		<article class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-emerald-400/50 hover:shadow-[0_12px_35px_rgba(16,185,129,0.08)] dark:border-slate-800 dark:bg-slate-950/50 sm:p-6">
			<div class="flex items-center gap-3">
				<span class="h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(16,185,129,0.8)]"></span>
				<h3 class="text-lg font-semibold text-slate-950 dark:text-slate-100">{category.categoryName}</h3>
			</div>
			<div class="mt-5 flex flex-wrap gap-2">
				{category.skills.map((skill) => <span class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 transition hover:border-emerald-400/70 hover:bg-emerald-400/10 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-300 dark:hover:text-emerald-300">{skill}</span>)}
			</div>
		</article>
		))}
	</section>)}
</div>