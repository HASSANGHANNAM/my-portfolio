---
import type { Project } from '../types/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const formatDate = (date: string) =>
	new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(date));
const mediaSlides = [
	...project.media.images.map((image) => ({ ...image, type: 'image' as const })),
	...project.media.videos.map((video) => ({ ...video, type: 'video' as const }))
].sort((first, second) => {
	const getNumber = (url: string) => Number(url.match(/\/(\d+)\.[^/]+$/)?.[1] ?? Number.MAX_SAFE_INTEGER);
	return getNumber(first.url) - getNumber(second.url);
});
---

<div class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 p-4 backdrop-blur-md sm:p-8" data-project-modal={project.id} aria-hidden="true">
	<div class="mx-auto flex min-h-full max-w-4xl items-center justify-center">
		<div class="relative my-8 w-full overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl" role="dialog" aria-modal="true" aria-labelledby={`${project.id}-title`}>
			<div class="flex items-start justify-between gap-6 border-b border-slate-800 px-6 py-5 sm:px-8">
				<div><p class="font-mono text-xs uppercase tracking-[0.18em] text-emerald-400">{project.projectType} / {formatDate(project.startDate)} - {formatDate(project.endDate)}</p><h2 id={`${project.id}-title`} class="mt-2 text-2xl font-semibold text-white sm:text-3xl">{project.title}</h2></div>
				<button type="button" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-700 text-2xl leading-none text-slate-400 transition hover:border-emerald-400 hover:text-emerald-400" data-project-close aria-label="Close project details">×</button>
			</div>

			{mediaSlides.length > 0 ? <div class="relative border-b border-slate-800 bg-slate-950">
				<div class="relative aspect-video overflow-hidden">
					{mediaSlides.map((slide, index) => <div class:list={['project-slide absolute inset-0 hidden items-center justify-center', { 'flex': index === 0 }]} data-slide-index={index}>
						{slide.type === 'image' ? <img src={slide.url} alt={slide.caption} loading={index === 0 ? 'eager' : 'lazy'} data-media-open data-media-target={`${project.id}-media-lightbox`} data-media-kind="image" data-media-src={slide.url} data-media-caption={slide.caption} data-media-gallery={JSON.stringify(mediaSlides)} class="h-full w-full cursor-zoom-in object-contain" /> : 'embed' in slide && slide.embed ? <iframe src={slide.url} title={slide.caption} allow="autoplay; fullscreen" allowfullscreen class="h-full w-full border-0"></iframe> : <video src={slide.url} controls preload="metadata" data-media-open data-media-target={`${project.id}-media-lightbox`} data-media-kind="video" data-media-src={slide.url} data-media-caption={slide.caption} data-media-gallery={JSON.stringify(mediaSlides)} class="h-full w-full cursor-zoom-in object-contain" aria-label={slide.caption}></video>}
						{slide.type === 'video' && 'embed' in slide && slide.embed && <button type="button" data-media-open data-media-target={`${project.id}-media-lightbox`} data-media-kind="embed" data-media-src={slide.url} data-media-caption={slide.caption} data-media-gallery={JSON.stringify(mediaSlides)} class="absolute right-3 top-3 rounded-lg border border-emerald-400/70 bg-slate-950/80 px-3 py-2 text-xs font-semibold text-emerald-300 transition hover:bg-emerald-400 hover:text-slate-950">Expand video</button>}
						<span class="absolute bottom-3 left-3 rounded bg-slate-950/80 px-2 py-1 text-xs text-slate-300">{slide.caption}</span>
					</div>)}
				</div>
				{mediaSlides.length > 1 && <><button type="button" data-carousel-prev class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950" aria-label="Previous media">&lt;</button><button type="button" data-carousel-next class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950" aria-label="Next media">&gt;</button><div class="absolute bottom-3 right-3 flex gap-1.5" role="tablist" aria-label="Project media slides">{mediaSlides.map((_, index) => <button type="button" class:list={['carousel-dot h-2.5 w-2.5 rounded-full bg-slate-600 transition', { 'bg-emerald-400': index === 0 }]} data-carousel-dot={index} aria-label={`Show media ${index + 1}`}></button>)}</div></>}
			</div> : <div class="relative border-b border-slate-800 bg-slate-950"><img src="/Attachments/avatar%20and%20another%20photo/project-placeholder.svg" alt={`${project.title} project preview placeholder`} data-media-open data-media-target={`${project.id}-media-lightbox`} data-media-kind="image" data-media-src="/Attachments/avatar%20and%20another%20photo/project-placeholder.svg" data-media-caption={`${project.title} project preview`} class="aspect-video w-full cursor-zoom-in object-cover" /></div>}

			<div class="grid gap-8 px-6 py-7 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
				<div class="space-y-6">
					{project.problem && <section><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">Problem</h3><p class="mt-2 leading-7 text-slate-300">{project.problem}</p></section>}
					{project.solution && <section><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">Solution</h3><p class="mt-2 leading-7 text-slate-300">{project.solution}</p></section>}
					{project.architecture && <section><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">Architecture</h3><p class="mt-2 leading-7 text-slate-300">{project.architecture}</p></section>}
					{project.challenges && project.challenges.length > 0 && <section><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">Challenges</h3><ul class="mt-2 space-y-2 leading-7 text-slate-300">{project.challenges.map((challenge) => <li class="flex gap-2"><span class="text-emerald-400">+</span>{challenge}</li>)}</ul></section>}
					{project.detailedSections.map((section) => <section><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">{section.heading}</h3><p class="mt-2 leading-7 text-slate-300">{section.content}</p></section>)}
				</div>
				<aside><h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">Technology</h3><div class="mt-3 flex flex-wrap gap-2">{project.techStack.map((technology) => <span class="rounded-md bg-slate-800 px-2.5 py-1 text-xs text-slate-300">{technology}</span>)}</div>{project.media.files.length > 0 && <><h3 class="mt-7 text-sm font-semibold uppercase tracking-wide text-emerald-400">Files</h3><div class="mt-3 space-y-2">{project.media.files.map((file) => <a href={file.url} target="_blank" rel="noreferrer" class="block text-sm text-slate-300 underline decoration-slate-600 underline-offset-4 hover:text-emerald-400">{file.name}</a>)}</div></>}{project.links.length > 0 && <><h3 class="mt-7 text-sm font-semibold uppercase tracking-wide text-emerald-400">Links</h3><div class="mt-3 flex flex-wrap gap-3">{project.links.map((link) => <a href={link.url} target="_blank" rel="noreferrer" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 transition hover:border-emerald-400 hover:text-emerald-400">{link.label} ↗</a>)}</div></>}</aside>
			</div>
		</div>
	</div>
</div>

<script src="../scripts/media-lightbox.ts"></script>

<div class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/90 p-4 backdrop-blur-md sm:p-8" data-media-lightbox={project.id + '-media-lightbox'} aria-hidden="true">
	<div class="relative flex max-h-full w-full max-w-6xl items-center justify-center">
		<button type="button" data-media-close class="absolute right-0 top-0 z-10 flex h-10 w-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-950/80 text-2xl text-slate-300 hover:border-emerald-400 hover:text-emerald-400" aria-label="Close media viewer">×</button>
		<button type="button" data-gallery-prev class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950" aria-label="Previous project image">&lt;</button>
		<img data-media-lightbox-image alt="" class="hidden max-h-[90vh] max-w-full object-contain" />
		<iframe data-media-lightbox-embed title="" allow="autoplay; fullscreen" allowfullscreen class="hidden aspect-video h-[80vh] w-full max-w-5xl border-0"></iframe>
		<video data-media-lightbox-video controls class="hidden max-h-[90vh] max-w-full"></video>
		<button type="button" data-gallery-next class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950" aria-label="Next project image">&gt;</button>
	</div>
</div>