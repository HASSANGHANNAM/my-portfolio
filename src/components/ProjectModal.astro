---
import type { Project } from "../types/portfolio";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const formatDate = (date: string) =>
    new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(
        new Date(date),
    );

const images = project.media?.images || [];
const imagesJson = JSON.stringify(images);
const firstImage = images[0]?.url || "/Attachments/avatar%20and%20another%20photo/project-placeholder.svg";
const firstCaption = images[0]?.caption || `${project.title} project preview`;
---

<div
    class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-950/80 p-4 backdrop-blur-md sm:p-8"
    data-project-modal={project.id}
    aria-hidden="true"
>
    <div class="mx-auto flex min-h-full max-w-4xl items-center justify-center">
        <div
            class="relative my-8 w-full overflow-hidden rounded-2xl border border-slate-700 bg-slate-900 shadow-2xl"
            role="dialog"
            aria-modal="true"
            aria-labelledby={`${project.id}-title`}
        >
            <div
                class="flex items-start justify-between gap-6 border-b border-slate-800 px-6 py-5 sm:px-8"
            >
                <div>
                    <p
                        class="font-mono text-xs uppercase tracking-[0.18em] text-emerald-400"
                    >
                        {project.projectType} / {formatDate(project.startDate)} -
                        {formatDate(project.endDate)}
                    </p>
                    <h2
                        id={`${project.id}-title`}
                        class="mt-2 text-2xl font-semibold text-white sm:text-3xl"
                    >
                        {project.title}
                    </h2>
                </div>
                <button
                    type="button"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-slate-700 text-2xl leading-none text-slate-400 transition hover:border-emerald-400 hover:text-emerald-400"
                    data-project-close
                    aria-label="Close project details"
                >×</button>
            </div>

            {/* سلايدر المودال الديناميكي السريع */}
            <div 
                class="project-modal-slider relative border-b border-slate-800 bg-slate-950"
                data-images={imagesJson}
            >
                <div class="relative aspect-video overflow-hidden flex items-center justify-center">
                    <img
                        src={firstImage}
                        alt={firstCaption}
                        loading="eager"
                        data-media-open
                        data-media-target={`${project.id}-media-lightbox`}
                        data-media-kind="image"
                        data-media-src={firstImage}
                        data-media-caption={firstCaption}
                        data-media-gallery={imagesJson}
                        class="project-modal-active-img h-full w-full cursor-zoom-in object-contain transition-opacity duration-200"
                    />
                    <span data-modal-caption class="absolute bottom-3 left-3 rounded bg-slate-950/80 px-2 py-1 text-xs text-slate-300">
                        {firstCaption}
                    </span>
                </div>

                {images.length > 1 && (
                    <>
                        <button
                            type="button"
                            data-carousel-prev
                            class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                            aria-label="Previous media"
                        >
                            &lt;
                        </button>
                        <button
                            type="button"
                            data-carousel-next
                            class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                            aria-label="Next media"
                        >
                            &gt;
                        </button>
                        <div
                            class="absolute bottom-3 right-3 flex gap-1.5 z-10"
                            role="tablist"
                            aria-label="Project media slides"
                        >
                            {images.map((_, index) => (
                                <button
                                    type="button"
                                    class:list={[
                                        "carousel-dot h-2.5 w-2.5 rounded-full bg-slate-600 transition",
                                        { "bg-emerald-400": index === 0 },
                                    ]}
                                    data-carousel-dot={index}
                                    aria-label={`Show media ${index + 1}`}
                                />
                            ))}
                        </div>
                    </>
                )}
            </div>

            <div class="grid gap-8 px-6 py-7 sm:px-8 lg:grid-cols-[1fr_0.8fr]">
                <div class="space-y-6">
                    {
                        project.problem && (
                            <section>
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    Problem
                                </h3>
                                <p class="mt-2 leading-7 text-slate-300">
                                    {project.problem}
                                </p>
                            </section>
                        )
                    }
                    {
                        project.solution && (
                            <section>
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    Solution
                                </h3>
                                <p class="mt-2 leading-7 text-slate-300">
                                    {project.solution}
                                </p>
                            </section>
                        )
                    }
                    {
                        project.architecture && (
                            <section>
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    Architecture
                                </h3>
                                <p class="mt-2 leading-7 text-slate-300">
                                    {project.architecture}
                                </p>
                            </section>
                        )
                    }
                    {
                        project.challenges && project.challenges.length > 0 && (
                            <section>
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    Challenges
                                </h3>
                                <ul class="mt-2 space-y-2 leading-7 text-slate-300">
                                    {project.challenges.map((challenge) => (
                                        <li class="flex gap-2">
                                            <span class="text-emerald-400">
                                                +
                                            </span>
                                            {challenge}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )
                    }
                    {
                        project.detailedSections.map((section) => (
                            <section>
                                <h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    {section.heading}
                                </h3>
                                <p class="mt-2 leading-7 text-slate-300">
                                    {section.content}
                                </p>
                            </section>
                        ))
                    }
                </div>
                <aside>
                    <h3
                        class="text-sm font-semibold uppercase tracking-wide text-emerald-400"
                    >
                        Technology
                    </h3>
                    <div class="mt-3 flex flex-wrap gap-2">
                        {
                            project.techStack.map((technology) => (
                                <span class="rounded-md bg-slate-800 px-2.5 py-1 text-xs text-slate-300">
                                    {technology}
                                </span>
                            ))
                        }
                    </div>
                    {
                        project.links && project.links.length > 0 && (
                            <>
                                <h3 class="mt-7 text-sm font-semibold uppercase tracking-wide text-emerald-400">
                                    Links & Resources
                                </h3>
                                <div class="mt-3 flex flex-wrap gap-3">
                                    {project.links.map((link: any) => (
                                        <a
                                            href={link.url}
                                            target="_blank"
                                            rel="noreferrer"
                                            class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 transition hover:border-emerald-400 hover:text-emerald-400"
                                        >
                                            {link.label || link.name} ↗
                                        </a>
                                    ))}
                                </div>
                            </>
                        )
                    }
                </aside>
            </div>
        </div>
    </div>
</div>

<script src="../scripts/media-lightbox.ts"></script>

{/* سكربت التحكم الديناميكي بالسلايدر داخل المودال */}
<script>
    document.querySelectorAll<HTMLElement>(".project-modal-slider").forEach((slider) => {
        const imgElement = slider.querySelector<HTMLImageElement>(".project-modal-active-img");
        const captionElement = slider.querySelector<HTMLElement>("[data-modal-caption]");
        const dots = slider.querySelectorAll<HTMLElement>("[data-carousel-dot]");
        const prevBtn = slider.querySelector("[data-carousel-prev]");
        const nextBtn = slider.querySelector("[data-carousel-next]");
        
        const imagesData = JSON.parse(slider.dataset.images || "[]");
        let currentIndex = 0;

        function updateSlide(index: number) {
            if (!imgElement || imagesData.length === 0) return;
            
            currentIndex = (index + imagesData.length) % imagesData.length;
            const currentImage = imagesData[currentIndex];
            
            // تحديث الصورة والوصف والـ Lightbox attributes ديناميكياً
            imgElement.src = currentImage.url;
            imgElement.dataset.mediaSrc = currentImage.url;
            imgElement.dataset.mediaCaption = currentImage.caption;
            
            if (captionElement) {
                captionElement.textContent = currentImage.caption;
            }

            dots.forEach((dot, i) => {
                dot.classList.toggle("bg-emerald-400", i === currentIndex);
                dot.classList.toggle("bg-slate-600", i !== currentIndex);
            });
        }

        prevBtn?.addEventListener("click", () => updateSlide(currentIndex - 1));
        nextBtn?.addEventListener("click", () => updateSlide(currentIndex + 1));

        dots.forEach((dot, index) => {
            dot.addEventListener("click", () => updateSlide(index));
        });
    });
</script>

<div
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/90 p-4 backdrop-blur-md sm:p-8"
    data-media-lightbox={project.id + "-media-lightbox"}
    aria-hidden="true"
>
    <div
        class="relative flex max-h-full w-full max-w-6xl items-center justify-center"
    >
        <button
            type="button"
            data-media-close
            class="absolute right-0 top-0 z-10 flex h-10 w-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-950/80 text-2xl text-slate-300 hover:border-emerald-400 hover:text-emerald-400"
            aria-label="Close media viewer">×</button
        >
        <button
            type="button"
            data-gallery-prev
            class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
            aria-label="Previous project image">&lt;</button
        >
        <img
            data-media-lightbox-image
            alt=""
            class="hidden max-h-[90vh] max-w-full object-contain"
        />
        <button
            type="button"
            data-gallery-next
            class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
            aria-label="Next project image">&gt;</button
        >
    </div>
</div>