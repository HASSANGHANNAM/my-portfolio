---
interface Props {
  cvUrl: string;
  fullName: string;
  title: string;
}

const { cvUrl, fullName, title } = Astro.props;
const tabs = [
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'certifications', label: 'Certifications' },
  { id: 'about', label: 'About' }
];
---

<header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-xl">
	<div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-8">
		<a href="#projects" class="group flex items-center gap-3" data-tab-link="projects"><img src="/Attachments/profile/profile.jpg" alt={`${fullName} profile photo`} class="h-10 w-10 rounded-xl border border-emerald-400/40 object-cover" /><span><span class="block text-sm font-semibold tracking-wide text-slate-100">{fullName}</span><span class="block text-xs text-slate-500">{title}</span></span></a>
		<nav aria-label="Portfolio sections" class="flex flex-wrap items-center gap-1 rounded-xl border border-slate-800 bg-slate-900/70 p-1">{tabs.map((tab) => <button type="button" class="tab-trigger rounded-lg border border-transparent px-3 py-2 text-sm text-slate-400 transition-colors hover:border-slate-700 hover:text-slate-100" data-tab={tab.id} aria-controls={`${tab.id}-content`} aria-selected={tab.id === 'projects'}>{tab.label}</button>)}</nav>
		<a href={cvUrl} download="Hassan_Ghanam_CV.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-lg border border-emerald-400/70 px-4 py-2 text-sm font-semibold text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950">Download CV</a>
	</div>
</header>
