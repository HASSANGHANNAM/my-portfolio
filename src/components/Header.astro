---
import ThemeToggle from './ThemeToggle.astro';
import personalInfo from '../data/en/personal.json';

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/skills', label: 'Skills' },
	{ href: '/certifications', label: 'Certifications' },
	{ href: '/contact', label: 'Contact' }
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<header class="border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-950/90">
	<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-4 px-5 py-5 lg:flex-nowrap lg:px-8">
		<a href="/" class="group flex min-w-0 items-center gap-3 lg:flex-1">
			<img src="/Attachments/profile/profile.jpg" alt={`${personalInfo.fullName} profile photo`} onerror="this.onerror=null; this.src='/Attachments/avatar%20and%20another%20photo/avatar.svg';" class="h-10 w-10 shrink-0 rounded-xl border border-emerald-400/40 object-cover transition group-hover:border-emerald-300" />
			<span class="min-w-0"><span class="block truncate text-sm font-semibold tracking-wide text-slate-900 dark:text-slate-100">{personalInfo.fullName}</span><span class="block truncate text-xs text-slate-500">{personalInfo.title}</span></span>
		</a>
		<nav aria-label="Main navigation" class="order-3 flex w-full flex-wrap justify-center gap-1 rounded-xl border border-slate-200 bg-slate-100/80 p-1 lg:order-none lg:w-auto dark:border-slate-800 dark:bg-slate-900/70">
			{links.map((link) => <a href={link.href} class:list={['rounded-lg border px-2.5 py-2 text-sm transition sm:px-3', isActive(link.href) ? 'nav-link-active border-emerald-500 bg-emerald-400/15 font-semibold text-emerald-700 dark:border-emerald-400 dark:text-emerald-300' : 'border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-950 dark:text-slate-400 dark:hover:border-slate-700 dark:hover:text-slate-100']} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
		</nav>
		<div class="flex items-center justify-end gap-2 lg:flex-1"><div class="flex items-center gap-1 rounded-lg border border-slate-300 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-900" aria-label="CV actions"><span class="px-2 text-xs font-semibold uppercase tracking-wide text-slate-500">CV</span><a href="/cv" title="View CV" aria-label="View CV" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-slate-600 transition hover:bg-emerald-400/15 hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></a><a href="/Attachments/cv.pdf" download="Hassan_Ghanam_CV.pdf" target="_blank" rel="noopener noreferrer" title="Download CV" aria-label="Download CV" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-emerald-600 transition hover:bg-emerald-400 hover:text-slate-950 dark:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg></a></div><ThemeToggle /></div>
	</div>
</header>
