---
import certificates from '../data/en/certificates.json';

const certificateMedia = certificates.map((certificate) => ({
	...certificate,
	images: certificate.images?.length ? certificate.images : [{ url: certificate.imageUrl, caption: certificate.title }]
}));

const formatDate = (date: string) =>
	new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(date));
---

<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
	{certificateMedia.map((certificate) => (
		<article class="overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-emerald-400/50 hover:shadow-[0_14px_40px_rgba(16,185,129,0.1)] dark:border-slate-800 dark:bg-slate-900/60">
			<div class="flex aspect-[16/9] items-center justify-center overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-950">
				<img src={certificate.images[0].url} alt={`${certificate.title} certificate`} loading="lazy" data-media-open data-media-target="certificates-media-lightbox" data-media-kind="image" data-media-src={certificate.images[0].url} data-media-caption={certificate.images[0].caption} data-media-gallery={JSON.stringify(certificate.images)} onerror="this.onerror=null; this.src='/images/certificate-placeholder.svg';" class="h-full w-full cursor-zoom-in object-cover" />
			</div>
			<div class="p-5 sm:p-6">
				<p class="font-mono text-xs uppercase tracking-wide text-emerald-400">Certificate / {formatDate(certificate.issueDate)}</p>
				<h3 class="mt-3 text-lg font-semibold leading-7 text-slate-950 dark:text-slate-100">{certificate.title}</h3>
				<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{certificate.issuer}</p>
				<div class="mt-5 flex flex-wrap gap-2">
					{certificate.skillsCovered.map((skill) => <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">{skill}</span>)}
				</div>
				{certificate.images.length > 1 && <button type="button" data-certificate-gallery={JSON.stringify(certificate.images)} class="mt-5 text-sm font-semibold text-emerald-600 hover:text-emerald-400 dark:text-emerald-400">View all images ({certificate.images.length}) →</button>}
			</div>
		</article>
	))}
</div>

<div class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/90 p-4 backdrop-blur-md sm:p-8" data-media-lightbox="certificates-media-lightbox" aria-hidden="true">
	<div class="relative flex max-h-full w-full max-w-6xl items-center justify-center">
		<button type="button" data-media-close class="absolute right-0 top-0 z-10 flex h-10 w-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-950/80 text-2xl text-slate-300 hover:border-emerald-400 hover:text-emerald-400" aria-label="Close certificate viewer">×</button>
		<button type="button" data-gallery-prev class="absolute left-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 hover:bg-emerald-400 hover:text-slate-950" aria-label="Previous certificate image">&lt;</button>
		<img data-media-lightbox-image alt="" class="max-h-[90vh] max-w-full object-contain" />
		<iframe data-media-lightbox-embed title="" allow="autoplay; fullscreen" allowfullscreen class="hidden aspect-video h-[80vh] w-full max-w-5xl border-0"></iframe>
		<video data-media-lightbox-video controls class="hidden max-h-[90vh] max-w-full"></video>
		<button type="button" data-gallery-next class="absolute right-0 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 hover:bg-emerald-400 hover:text-slate-950" aria-label="Next certificate image">&gt;</button>
	</div>
</div>

<script src="../scripts/media-lightbox.ts"></script>