---
import certificates from "../data/en/certificates.json";

const categories = ["Academic", "Programming Advices", "Achievements"] as const;

const certificateMedia = certificates.map((certificate) => ({
    ...certificate,
    images: certificate.images || [],
}));

const formatDate = (date: string) =>
    new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(
        new Date(date),
    );
---

<div class="space-y-16">
    {
        categories.map((category, categoryIndex) => {
            const categoryCertificates = certificateMedia.filter(
                (certificate) => certificate.category === category,
            );
            return (
                <section
                    aria-labelledby={`${category.toLowerCase().replaceAll(" ", "-")}-heading`}
                >
                    <div class="mb-7">
                        <>
                            <p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">
                                0{categoryIndex + 1} / Credentials
                            </p>
                            <h2
                                id={`${category.toLowerCase().replaceAll(" ", "-")}-heading`}
                                class="mt-2 text-2xl font-semibold text-slate-950 dark:text-white"
                            >
                                {category}
                            </h2>
                        </>
                    </div>
                    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                        {categoryCertificates.map((certificate) => {
                            const lightboxId = `cert-${certificate.title.toLowerCase().replaceAll(/[^a-z0-9]/g, "-")}`;
                            return (
                                <article class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:-translate-y-1 hover:border-emerald-400/50 hover:shadow-[0_14px_40px_rgba(16,185,129,0.1)] dark:border-slate-800 dark:bg-slate-900/60">
                                    {/* سلايدر عرض الصور داخل البطاقة */}
                                    <div class="certificate-slider relative aspect-[16/9] overflow-hidden border-b border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-950">
                                        <div class="relative h-full w-full">
                                            {certificate.images.map(
                                                (img, imgIndex) => (
                                                    <div
                                                        class:list={[
                                                            "certificate-slide absolute inset-0 h-full w-full items-center justify-center",
                                                            imgIndex === 0
                                                                ? "flex"
                                                                : "hidden",
                                                        ]}
                                                        data-slide-index={
                                                            imgIndex
                                                        }
                                                    >
                                                        <img
                                                            src={img.url}
                                                            alt={`${certificate.title} certificate`}
                                                            loading={
                                                                imgIndex === 0
                                                                    ? "eager"
                                                                    : "lazy"
                                                            }
                                                            data-media-open
                                                            data-media-target={
                                                                lightboxId
                                                            }
                                                            data-media-kind="image"
                                                            data-media-src={
                                                                img.url
                                                            }
                                                            data-media-gallery={JSON.stringify(
                                                                certificate.images,
                                                            )}
                                                            onerror="this.onerror=null; this.src='/Attachments/avatar%20and%20another%20photo/certificate-placeholder.svg';"
                                                            class="h-full w-full cursor-zoom-in object-cover"
                                                        />
                                                    </div>
                                                ),
                                            )}
                                        </div>

                                        {/* أزرار ونقاط التقليب تظهر فقط إذا كان هناك أكثر من صورة */}
                                        {certificate.images.length > 1 && (
                                            <>
                                                <button
                                                    type="button"
                                                    data-carousel-prev
                                                    class="absolute left-2 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-sm text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                                                    aria-label="Previous image"
                                                >
                                                    &lt;
                                                </button>
                                                <button
                                                    type="button"
                                                    data-carousel-next
                                                    class="absolute right-2 top-1/2 z-10 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-sm text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                                                    aria-label="Next image"
                                                >
                                                    &gt;
                                                </button>
                                                <div
                                                    class="absolute bottom-2 right-2 z-10 flex gap-1.5"
                                                    role="tablist"
                                                    aria-label="Certificate slides"
                                                >
                                                    {certificate.images.map(
                                                        (_, dotIndex) => (
                                                            <button
                                                                type="button"
                                                                class:list={[
                                                                    "carousel-dot h-2 w-2 rounded-full bg-slate-600 transition",
                                                                    {
                                                                        "bg-emerald-400":
                                                                            dotIndex ===
                                                                            0,
                                                                    },
                                                                ]}
                                                                data-carousel-dot={
                                                                    dotIndex
                                                                }
                                                                aria-label={`Show image ${dotIndex + 1}`}
                                                            />
                                                        ),
                                                    )}
                                                </div>
                                            </>
                                        )}
                                    </div>

                                    {/* معلومات الشهادة */}
                                    <div class="p-5 sm:p-6">
                                        <p class="font-mono text-xs uppercase tracking-wide text-emerald-400">
                                            Certificate /{" "}
                                            {formatDate(certificate.issueDate)}
                                        </p>
                                        <h3 class="mt-3 text-lg font-semibold leading-7 text-slate-950 dark:text-slate-100">
                                            {certificate.title}
                                        </h3>
                                        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
                                            {certificate.issuer}
                                        </p>
                                        <div class="mt-5 flex flex-wrap gap-2">
                                            {certificate.skillsCovered.map(
                                                (skill) => (
                                                    <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                                        {skill}
                                                    </span>
                                                ),
                                            )}
                                        </div>
                                    </div>
                                </article>
                            );
                        })}
                    </div>
                </section>
            );
        })
    }
</div>

{/* نافذة الـ Lightbox المكبرة */}
{
    categories.map((category) => {
        const categoryCertificates = certificateMedia.filter(
            (certificate) => certificate.category === category,
        );
        return categoryCertificates.map((certificate) => {
            const lightboxId = `cert-${certificate.title.toLowerCase().replaceAll(/[^a-z0-9]/g, "-")}`;
            return (
                <div
                    class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/90 p-4 backdrop-blur-md sm:p-8"
                    data-media-lightbox={lightboxId}
                    aria-hidden="true"
                >
                    <div class="relative flex max-h-full w-full max-w-6xl items-center justify-center">
                        <button
                            type="button"
                            data-media-close
                            class="absolute right-0 top-0 z-10 flex h-10 w-10 items-center justify-center rounded-lg border border-slate-600 bg-slate-950/80 text-2xl text-slate-300 hover:border-emerald-400 hover:text-emerald-400"
                            aria-label="Close viewer"
                        >
                            ×
                        </button>
                        <button
                            type="button"
                            data-gallery-prev
                            class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                            aria-label="Previous image"
                        >
                            &lt;
                        </button>
                        <img
                            data-media-lightbox-image
                            alt=""
                            class="max-h-[90vh] max-w-full object-contain"
                        />
                        <button
                            type="button"
                            data-gallery-next
                            class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/70 bg-slate-950/80 text-xl text-emerald-400 transition hover:bg-emerald-400 hover:text-slate-950"
                            aria-label="Next image"
                        >
                            &gt;
                        </button>
                    </div>
                </div>
            );
        });
    })
}

{/* سكربت إدارة السلايدر المصغر */}
<script>
    document.querySelectorAll(".certificate-slider").forEach((slider) => {
        const slides =
            slider.querySelectorAll<HTMLElement>(".certificate-slide");
        const dots = slider.querySelectorAll<HTMLElement>(
            "[data-carousel-dot]",
        );
        const prevBtn = slider.querySelector("[data-carousel-prev]");
        const nextBtn = slider.querySelector("[data-carousel-next]");
        let currentIndex = 0;

        function updateSlide(index: number) {
            slides.forEach((slide, i) => {
                slide.classList.toggle("flex", i === index);
                slide.classList.toggle("hidden", i !== index);
            });
            dots.forEach((dot, i) => {
                dot.classList.toggle("bg-emerald-400", i === index);
                dot.classList.toggle("bg-slate-600", i !== index);
            });
            currentIndex = index;
        }

        prevBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            const newIndex = (currentIndex - 1 + slides.length) % slides.length;
            updateSlide(newIndex);
        });

        nextBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            const newIndex = (currentIndex + 1) % slides.length;
            updateSlide(newIndex);
        });

        dots.forEach((dot, index) => {
            dot.addEventListener("click", (e) => {
                e.stopPropagation();
                updateSlide(index);
            });
        });
    });
</script>

<script src="../scripts/media-lightbox.ts"></script>
