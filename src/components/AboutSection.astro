---
import personalInfo from '../data/en/personal.json';

const socialLinks = [
	{ label: 'GitHub', key: 'github' as const },
	{ label: 'LinkedIn', key: 'linkedin' as const },
	{ label: 'Codeforces', key: 'codeforces' as const }
];
---

<div class="space-y-8">
	<div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-start lg:gap-12">
		<div class="border-l-2 border-emerald-400 pl-5">
			<p class="text-xs uppercase tracking-wide text-slate-500">Education</p>
			<p class="mt-2 max-w-3xl text-base leading-7 text-slate-700 dark:text-slate-200">{personalInfo.education}</p>
		</div>

		<aside class="w-full rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 lg:max-w-xs dark:border-slate-800 dark:bg-slate-900/60">
		<p class="text-sm font-semibold text-slate-900 dark:text-slate-100">Professional profiles</p>
		<div class="mt-4 flex flex-col gap-2">
			{socialLinks.map((social) => <a href={personalInfo.socialLinks[social.key]} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-between rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-700 transition hover:border-emerald-400 hover:bg-emerald-400/10 hover:text-emerald-600 dark:border-slate-700 dark:text-slate-300 dark:hover:text-emerald-300"><span>{social.label}</span><span aria-hidden="true" class="text-emerald-400">↗</span></a>)}
			<div class="mt-1 flex items-center gap-1 rounded-lg border border-slate-300 bg-slate-50 p-1 dark:border-slate-700 dark:bg-slate-900" aria-label="CV actions"><span class="px-2 text-xs font-semibold uppercase tracking-wide text-slate-500">CV</span><a href="/cv" title="View CV" aria-label="View CV" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-slate-600 transition hover:bg-emerald-400/15 hover:text-emerald-600 dark:text-slate-300 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></a><a href="/cv.pdf" download="Hassan_Ghanam_CV.pdf" target="_blank" rel="noopener noreferrer" title="Download CV" aria-label="Download CV" class="inline-flex h-9 w-9 items-center justify-center rounded-md text-emerald-600 transition hover:bg-emerald-400 hover:text-slate-950 dark:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg></a></div>
		</div>
		</aside>
	</div>
</div>