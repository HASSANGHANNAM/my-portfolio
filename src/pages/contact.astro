---
import Layout from '../layouts/Layout.astro';
import personalInfo from '../data/en/personal.json';
---

<Layout title={`Contact | ${personalInfo.fullName}`}>
	<section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
		<div class="mx-auto max-w-2xl text-center"><p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">05 / Contact</p><h1 class="mt-2 text-4xl font-semibold text-slate-950 dark:text-white sm:text-5xl">Let’s connect</h1><p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-400">You can reach me directly through the contact details below.</p></div>
		<div class="mx-auto mt-12 max-w-xl space-y-3"><p class="mb-5 text-center text-sm font-semibold text-slate-950 dark:text-slate-100">Direct contact</p><a href={`mailto:${personalInfo.socialLinks.email}`} class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:text-slate-400 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><span>{personalInfo.socialLinks.email}</span></a><a href={`tel:${personalInfo.socialLinks.phone.replaceAll(' ', '')}`} class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:text-slate-400 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0"><path d="M7 3h3l2 5-2 2c1 2 2 3 4 4l2-2 5 2v3c0 1-1 2-2 2C11 19 5 13 5 5c0-1 1-2 2-2Z"/></svg><span>{personalInfo.socialLinks.phone}</span></a><a href={personalInfo.socialLinks.locationUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:text-slate-400 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>{personalInfo.socialLinks.location}</span></a><a href={personalInfo.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 rounded-lg border border-slate-200 px-4 py-3 text-sm text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:text-slate-400 dark:hover:text-emerald-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0"><path d="M6.5 8.5A1.5 1.5 0 1 0 6.5 5a1.5 1.5 0 0 0 0 3.5ZM5 10h3v9H5v-9Zm5 0h3v1.3c.7-1 1.7-1.6 3.2-1.6 3 0 3.8 1.9 3.8 4.8V19h-3v-4c0-1 0-2.3-1.5-2.3S13 13.8 13 15v4h-3v-9Z"/></svg><span>LinkedIn</span></a></div>
	</section>
</Layout>
