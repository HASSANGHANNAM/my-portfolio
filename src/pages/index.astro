---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import CertificatesSection from '../components/CertificatesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import personalInfo from '../data/en/personal.json';
import projects from '../data/en/projects.json';
import skills from '../data/en/skills.json';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${personalInfo.fullName} - ${personalInfo.title}`} />
		<title>{personalInfo.fullName} | {personalInfo.title}</title>
	</head>
	<body class="min-h-screen bg-slate-950 text-slate-100">
		<Navbar cvUrl={personalInfo.cvUrl} fullName={personalInfo.fullName} title={personalInfo.title} />

		<main class="mx-auto max-w-6xl px-5 pb-20 pt-12 lg:px-8">
			<section class="mb-12 grid gap-8 border-b border-slate-800 pb-12 lg:grid-cols-[1fr_auto] lg:items-end">
				<div class="max-w-3xl">
					<p class="mb-4 font-mono text-sm uppercase tracking-[0.2em] text-emerald-400">Backend / Systems / APIs</p>
					<h1 class="max-w-2xl text-4xl font-semibold tracking-tight text-white sm:text-6xl">Building dependable software for complex systems.</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">{personalInfo.bio}</p>
				</div>
				<div class="grid grid-cols-2 gap-3 text-sm text-slate-400 lg:min-w-56">
					<div class="border-l-2 border-emerald-400 px-4 py-2"><strong class="block text-2xl text-slate-100">{projects.length}</strong>Selected projects</div>
					<div class="border-l-2 border-slate-700 px-4 py-2"><strong class="block text-2xl text-slate-100">{skills.reduce((total, group) => total + group.skills.length, 0)}</strong>Core skills</div>
				</div>
			</section>

			<section id="projects-content" class="tab-content transition-opacity duration-150" data-content="projects" aria-labelledby="projects-tab">
				<div class="mb-8 flex items-end justify-between gap-4">
					<div><p class="font-mono text-sm text-emerald-400">01 / Work</p><h2 class="mt-2 text-3xl font-semibold text-white">Selected projects</h2></div>
					<p class="hidden text-sm text-slate-500 sm:block">A few systems I have designed and shipped.</p>
				</div>
				<ProjectsSection />
			</section>

			<section id="skills-content" class="tab-content hidden opacity-0 transition-opacity duration-150" data-content="skills" aria-labelledby="skills-tab">
				<div class="mb-8"><p class="font-mono text-sm text-emerald-400">02 / Toolkit</p><h2 class="mt-2 text-3xl font-semibold text-white">Skills and technologies</h2></div>
				<SkillsSection />
			</section>

			<section id="certifications-content" class="tab-content hidden opacity-0 transition-opacity duration-150" data-content="certifications" aria-labelledby="certifications-tab">
				<div class="mb-8"><p class="font-mono text-sm text-emerald-400">03 / Credentials</p><h2 class="mt-2 text-3xl font-semibold text-white">Certifications</h2></div>
				<CertificatesSection />
			</section>

			<section id="about-content" class="tab-content hidden opacity-0 transition-opacity duration-150" data-content="about" aria-labelledby="about-tab">
				<AboutSection />
			</section>
		</main>

		<script>
			const triggers = document.querySelectorAll<HTMLButtonElement>('.tab-trigger');
			const contents = document.querySelectorAll<HTMLElement>('.tab-content');

			function switchTab(tabId: string) {
				triggers.forEach((trigger) => {
					const isActive = trigger.dataset.tab === tabId;
					trigger.classList.toggle('border-emerald-400', isActive);
					trigger.classList.toggle('bg-emerald-400/10', isActive);
					trigger.classList.toggle('text-emerald-400', isActive);
					trigger.classList.toggle('text-slate-400', !isActive);
					trigger.setAttribute('aria-selected', String(isActive));
				});

				contents.forEach((content) => {
					const isActive = content.dataset.content === tabId;
					content.classList.toggle('hidden', !isActive);
					content.classList.toggle('opacity-0', !isActive);
					content.classList.toggle('opacity-100', isActive);
				});
			}

			triggers.forEach((trigger) => trigger.addEventListener('click', () => switchTab(trigger.dataset.tab ?? 'projects')));
			document.querySelectorAll<HTMLElement>('[data-tab-link]').forEach((link) => link.addEventListener('click', (event) => {
				event.preventDefault();
				switchTab(link.dataset.tabLink ?? 'projects');
			}));
			switchTab('projects');
		</script>
	</body>
</html>
