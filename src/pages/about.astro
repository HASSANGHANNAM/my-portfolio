---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/AboutSection.astro';
import personalInfo from '../data/en/personal.json';
---

<Layout title={`About | ${personalInfo.fullName}`}>
	<section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
		<div class="mb-10 flex flex-col gap-8 border-b border-slate-200 pb-10 dark:border-slate-800 sm:flex-row sm:items-center">
			<div class="flex h-32 w-32 shrink-0 items-center justify-center rounded-3xl border border-emerald-400/50 bg-emerald-400/10 font-mono text-4xl font-bold text-emerald-600 dark:text-emerald-400" role="img" aria-label={`${personalInfo.fullName} profile photo placeholder`}>HG</div>
			<div><p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">04 / Profile</p><h1 class="mt-2 text-4xl font-semibold text-slate-950 dark:text-white sm:text-5xl">About me</h1><p class="mt-3 text-slate-600 dark:text-slate-400">{personalInfo.title}</p></div>
		</div>
		<AboutSection />
	</section>
</Layout>
