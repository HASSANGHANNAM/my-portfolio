---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/AboutSection.astro';
import personalInfo from '../data/en/personal.json';
---

<Layout title={`About | ${personalInfo.fullName}`}>
	<section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
		<div class="mb-10 flex flex-col gap-8 border-b border-slate-200 pb-10 dark:border-slate-800 sm:flex-row sm:items-start sm:gap-10">
			<div class="h-56 w-40 shrink-0 overflow-hidden rounded-3xl border border-emerald-400/50 bg-emerald-400/10 shadow-[0_12px_30px_rgba(16,185,129,0.14)] sm:mt-8 sm:h-80 sm:w-56"><img src="/images/profile.jpg" alt={`${personalInfo.fullName} profile photo`} onerror="this.onerror=null; this.src='/images/avatar.svg';" class="h-full w-full object-cover" /></div>
			<div class="max-w-3xl"><p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">04 / Profile</p><h1 class="mt-2 text-4xl font-semibold text-slate-950 dark:text-white sm:text-5xl">About me</h1><p class="mt-3 text-slate-600 dark:text-slate-400">{personalInfo.title}</p><p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-400">{personalInfo.bio}</p></div>
		</div>
		<AboutSection />
	</section>
</Layout>
