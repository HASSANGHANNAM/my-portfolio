import ProjectsSection from '../components/ProjectsSection.astro';
---

<Layout title="Projects | Hassan Ghanam">
	<section class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-24">
		<p class="font-mono text-sm text-emerald-600 dark:text-emerald-400">01 / Work</p>
		<h1 class="mt-2 text-4xl font-semibold text-slate-950 dark:text-white sm:text-5xl">Selected projects</h1>
		<p class="mt-5 max-w-2xl text-lg text-slate-600 dark:text-slate-400">A few systems I have designed and shipped.</p>
		<div class="mt-10"><ProjectsSection /></div>
	</section>
</Layout>
